# ---- PlatformIO 构建产物 ----
# 100+ MB,且由 `pio run` 可完整重建;CI 里会自己编译一次验证,无需入库。
.pio

# ---- 浏览器 profile(凭据,红线) ----
# .workbuddy/tmp 下这两份是 Chrome 个人档案,含 Login Data(已保存的账号
# 密码)、Network/Cookies、History、Web Data 等敏感信息,体积约 21 MB。
# 本仓库是公开仓库,任何情况下都不得放行下面两行。
.workbuddy/tmp/chrome-profile/
.workbuddy/tmp/cp2/

# ---- Python 字节码缓存(生成物) ----
__pycache__/
*.pyc

# ---- 编辑器/终端误存的临时文件 ----
*.tmp
h
